{
  "name": "iconify-lsp",
  "version": "0.1.0",
  "description": "Language server for Iconify icon names: completion and hover previews",
  "license": "MIT",
  "author": "PleahMaCaka <pleahmacaka@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PleahMaCaka/iconify-lsp.git"
  },
  "keywords": [
    "iconify",
    "icons",
    "language-server",
    "lsp"
  ],
  "type": "module",
  "bin": {
    "iconify-lsp": "dist/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target node --outfile dist/server.js",
    "check": "tsc",
    "lint": "biome check .",
    "prepublishOnly": "bun run check && bun run lint && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@sveltejs/acorn-typescript": "^1.0.13",
    "@types/node": "^26.6.5",
    "@typescript-eslint/types": "^8.71.2",
    "acorn": "^8.19.0",
    "typescript": "^7.0.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  }
}
